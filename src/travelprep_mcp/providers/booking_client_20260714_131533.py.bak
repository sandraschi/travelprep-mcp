"""Booking.com provider -- wraps insprd/hotelzero (MIT, Playwright-based) over stdio.

Status: SCAFFOLDED, NOT YET LIVE-TESTED. Chosen over the RapidAPI-backed
alternatives (esakrissa/hotels_mcp_server, EmilyThaHuman/booking-mcp-server)
because it needs no paid API key -- consistent with the Airbnb provider's
scrape-and-parse approach and the fleet's budget-aware / local-first
doctrine. An official Booking.com remote MCP also exists
(https://demandapi-mcp.booking.com/v1/mcp/...) but requires OAuth via a
Booking.com partner account; unverified whether that's open to an
individual/non-affiliate account, so not used here for v0.1.

Exact tool names below (`hotel_search`, `hotel_details`) are best-effort
from the upstream README and NOT yet confirmed against a live
`list_tools()` call. Run `tests/test_booking_client.py` and fix the
names there before wiring this into `stays.py` for real.

Upstream: https://github.com/insprd/hotelzero
"""

from __future__ import annotations

from typing import Any

from travelprep_mcp.providers.base import StdioProvider

_provider = StdioProvider(package="hotelzero")


async def search(
    location: str,
    checkin: str | None = None,
    checkout: str | None = None,
    adults: int = 1,
) -> Any:
    args: dict[str, Any] = {"location": location, "adults": adults}
    if checkin:
        args["checkin"] = checkin
    if checkout:
        args["checkout"] = checkout
    return await _provider.call_tool("hotel_search", args)


async def hotel_details(hotel_url: str) -> Any:
    return await _provider.call_tool("hotel_details", {"url": hotel_url})
