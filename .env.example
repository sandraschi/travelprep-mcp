# travelprep-mcp -- environment variables
#
# Copy this file to .env and fill in your values.
# The server works without any of these for basic functionality.

# Transport mode (stdio or http). Default: stdio
# MCP_TRANSPORT=http

# HTTP server host/port (only used when MCP_TRANSPORT=http)
# MCP_HOST=127.0.0.1
# MCP_PORT=11099
